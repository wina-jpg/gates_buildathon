# Hugging Face (required for live JD generation)
HF_API_KEY=hf_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional model / router settings
HF_MODEL=meta-llama/Llama-3.1-8B-Instruct
HF_PROVIDER=fastest
HF_MAX_TOKENS=512
HF_CHAT_URL=https://router.huggingface.co/v1/chat/completions

# Knowledge context size
MAX_CONTEXT_CHARS=1800

# Comma-separated extra CORS origins (Vercel preview URLs are allowed via regex)
# CORS_ORIGINS=https://your-custom-domain.com
